    <bpmn:sequenceFlow id="F15" sourceRef="T10" targetRef="G04" />
    <bpmn:sequenceFlow id="F16" sourceRef="G04" targetRef="T11" />
    <bpmn:sequenceFlow id="F17" sourceRef="T11" targetRef="T13" />
    <bpmn:sequenceFlow id="F18" sourceRef="T13" targetRef="T14" />
    <bpmn:sequenceFlow id="F19" sourceRef="T14" targetRef="T16" />
    <bpmn:sequenceFlow id="F20" sourceRef="G04" targetRef="T15" />
    <bpmn:sequenceFlow id="F21" sourceRef="T16" targetRef="G05" />
    <bpmn:sequenceFlow id="F22" sourceRef="T15" targetRef="G05" />
    <bpmn:sequenceFlow id="F23" sourceRef="G05" targetRef="E_end" />
    <bpmn:dataStoreReference id="DS1" name="Cliensa CRM (clientes, contratos, avisos)" />
    <bpmn:dataStoreReference id="DS2" name="ASIGNA 3.1 (órdenes y agenda; PC de coordinación)" />
    <bpmn:dataStoreReference id="DS3" name="Contanor ERP (almacén)" />
    <bpmn:dataStoreReference id="DS4" name="Hoja «Partes pendientes» (Administración)" />
    <bpmn:dataStoreReference id="DS5" name="Cliensa CRM (tarifa; estado del aviso)" />
    <bpmn:dataStoreReference id="DS6" name="Contanor ERP (servicios, facturas)" />
  </bpmn:process>
