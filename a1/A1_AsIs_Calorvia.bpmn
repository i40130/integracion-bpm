<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Calorvia_AsIs" targetNamespace="http://calorvia.example/bpmn" exporter="A1 generator" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_Calorvia" name="Calorvía Servicios Técnicos — proceso AS-IS «De aviso a factura»" processRef="Proc_AsIs" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_AsIs" name="De aviso a factura (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_cli" name="Cliente">
        <bpmn:flowNodeRef>E_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coo" name="Coordinación de servicio">
        <bpmn:flowNodeRef>T02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_tec" name="Técnico">
        <bpmn:flowNodeRef>T07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G04</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_adm" name="Administración y almacén">
        <bpmn:flowNodeRef>T08b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="E_start" name="Avería o incidencia detectada">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T01" name="Comunicar aviso (portal web, correo o teléfono)">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T02" name="Registrar aviso en Cliensa CRM">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_3">
        <bpmn:targetRef>DS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T03" name="Comprobar contrato y nivel de servicio en Cliensa">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:property id="Prop_DIA_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_1">
        <bpmn:sourceRef>DS1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_DIA_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T04" name="Crear orden de trabajo en ASIGNA 3.1 (tecleo)">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:property id="Prop_DIA_2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_2">
        <bpmn:sourceRef>DS1</bpmn:sourceRef>
        <bpmn:targetRef>Prop_DIA_2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_5">
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T05" name="Asignar técnico y enviarle los datos por WhatsApp">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:property id="Prop_DIA_4" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_4">
        <bpmn:sourceRef>DS2</bpmn:sourceRef>
        <bpmn:targetRef>Prop_DIA_4</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T06" name="Confirmar cita al cliente por teléfono">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T07" name="Desplazarse e intervenir">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G02" name="¿Necesita repuesto?">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T08" name="Pedir repuesto al almacén por teléfono">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T08b" name="Reservar y entregar repuesto (Contanor ERP)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_6">
        <bpmn:targetRef>DS3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G03">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T09" name="Cumplimentar parte en papel y recoger firma">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Enviar foto del parte (WhatsApp o correo)">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G04">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T11" name="Anotar recepción en la hoja «Partes pendientes»">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_7">
        <bpmn:targetRef>DS4</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T13" name="Transcribir parte en Contanor ERP (tarifa según Cliensa)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:property id="Prop_DIA_8" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_8">
        <bpmn:sourceRef>DS5</bpmn:sourceRef>
        <bpmn:targetRef>Prop_DIA_8</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_10">
        <bpmn:targetRef>DS6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T14" name="Emitir factura y enviarla por correo">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_11">
        <bpmn:targetRef>DS6</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T15" name="Actualizar estado del aviso en Cliensa (fin del día)">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_9">
        <bpmn:targetRef>DS5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T16" name="Recibir factura">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G05">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E_end" name="Servicio facturado">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="E_start" targetRef="T01" />
    <bpmn:sequenceFlow id="F02" sourceRef="T01" targetRef="T02" />
    <bpmn:sequenceFlow id="F03" sourceRef="T02" targetRef="T03" />
