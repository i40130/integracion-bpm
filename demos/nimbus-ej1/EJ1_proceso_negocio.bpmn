<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_EJ1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Iago Moure - UNIR Master BPM" exporterVersion="1.0">

  <!-- ============ MODELO SEMÁNTICO ============ -->
  <bpmn:collaboration id="Collaboration_EJ1">
    <bpmn:participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente" />
    <bpmn:participant id="Participant_Soporte" name="Centro de Soporte" processRef="Process_Soporte" />

    <bpmn:messageFlow id="MsgFlow_Form" name="Incidencia" sourceRef="Task_Form" targetRef="Start_Sop" />
    <bpmn:messageFlow id="MsgFlow_Email" name="Correo de confirmación" sourceRef="Task_Confirmar" targetRef="Catch_Conf" />
  </bpmn:collaboration>

  <!-- ===== Pool Cliente ===== -->
  <bpmn:process id="Process_Cliente" isExecutable="false">
    <bpmn:startEvent id="Start_Cli" name="Necesita reportar una incidencia">
      <bpmn:outgoing>Flow_c1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Form" name="Cumplimentar y enviar formulario de incidencia">
      <bpmn:incoming>Flow_c1</bpmn:incoming>
      <bpmn:outgoing>Flow_c2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_Conf" name="Recibir el correo de confirmación">
      <bpmn:incoming>Flow_c2</bpmn:incoming>
      <bpmn:outgoing>Flow_c3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Conf" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Cli" name="Incidencia reportada">
      <bpmn:incoming>Flow_c3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_c1" sourceRef="Start_Cli" targetRef="Task_Form" />
    <bpmn:sequenceFlow id="Flow_c2" sourceRef="Task_Form" targetRef="Catch_Conf" />
    <bpmn:sequenceFlow id="Flow_c3" sourceRef="Catch_Conf" targetRef="End_Cli" />
  </bpmn:process>

  <!-- ===== Pool Centro de Soporte ===== -->
  <bpmn:process id="Process_Soporte" isExecutable="false">

    <bpmn:startEvent id="Start_Sop" name="Incidencia recibida">
      <bpmn:outgoing>Flow_s1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Incidencia" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Registrar" name="Registrar la incidencia">
      <bpmn:incoming>Flow_s1</bpmn:incoming>
      <bpmn:outgoing>Flow_s2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Confirmar" name="Enviar el correo de confirmación">
      <bpmn:incoming>Flow_s2</bpmn:incoming>
      <bpmn:outgoing>Flow_s3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Sup" name="Incidencia registrada y cliente notificado">
      <bpmn:incoming>Flow_s3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_s1" sourceRef="Start_Sop" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="Flow_s2" sourceRef="Task_Registrar" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="Flow_s3" sourceRef="Task_Confirmar" targetRef="End_Sup" />
  </bpmn:process>

  <!-- ============ DIAGRAM INTERCHANGE (layout) ============ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_EJ1">
    <bpmndi:BPMNPlane id="BPMNPlane_EJ1" bpmnElement="Collaboration_EJ1">

      <!-- Pool Cliente -->
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="780" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cli_di" bpmnElement="Start_Cli">
        <dc:Bounds x="212" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="190" y="98" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Form_di" bpmnElement="Task_Form">
        <dc:Bounds x="300" y="100" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Catch_Conf_di" bpmnElement="Catch_Conf">
        <dc:Bounds x="662" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="640" y="98" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cli_di" bpmnElement="End_Cli">
        <dc:Bounds x="812" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="798" y="161" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_c1_di" bpmnElement="Flow_c1">
        <di:waypoint x="248" y="140" /><di:waypoint x="300" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c2_di" bpmnElement="Flow_c2">
        <di:waypoint x="460" y="140" /><di:waypoint x="662" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_c3_di" bpmnElement="Flow_c3">
        <di:waypoint x="698" y="140" /><di:waypoint x="812" y="140" />
      </bpmndi:BPMNEdge>

      <!-- Pool Soporte -->
      <bpmndi:BPMNShape id="Participant_Soporte_di" bpmnElement="Participant_Soporte" isHorizontal="true">
        <dc:Bounds x="160" y="240" width="780" height="360" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_Sop_di" bpmnElement="Start_Sop">
        <dc:Bounds x="242" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="220" y="258" width="82" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Registrar_di" bpmnElement="Task_Registrar">
        <dc:Bounds x="380" y="385" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirmar_di" bpmnElement="Task_Confirmar">
        <dc:Bounds x="600" y="505" width="160" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Sup_di" bpmnElement="End_Sup">
        <dc:Bounds x="842" y="522" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="820" y="561" width="82" height="40" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_s1_di" bpmnElement="Flow_s1">
        <di:waypoint x="260" y="318" /><di:waypoint x="260" y="420" /><di:waypoint x="380" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_s2_di" bpmnElement="Flow_s2">
        <di:waypoint x="540" y="420" /><di:waypoint x="680" y="420" /><di:waypoint x="680" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_s3_di" bpmnElement="Flow_s3">
        <di:waypoint x="760" y="540" /><di:waypoint x="842" y="540" />
      </bpmndi:BPMNEdge>

      <!-- Message flows entre pools -->
      <bpmndi:BPMNEdge id="MsgFlow_Form_di" bpmnElement="MsgFlow_Form">
        <di:waypoint x="380" y="180" /><di:waypoint x="380" y="230" /><di:waypoint x="260" y="230" /><di:waypoint x="260" y="282" />
        <bpmndi:BPMNLabel><dc:Bounds x="286" y="205" width="90" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MsgFlow_Email_di" bpmnElement="MsgFlow_Email">
        <di:waypoint x="680" y="505" /><di:waypoint x="680" y="158" />
        <bpmndi:BPMNLabel><dc:Bounds x="690" y="320" width="84" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
